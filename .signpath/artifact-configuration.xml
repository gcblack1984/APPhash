<?xml version="1.0" encoding="utf-8"?>
<!--
  Configurazione dell'artefatto per SignPath (copia di riferimento: quella valida
  e' quella inserita nel progetto su SignPath).

  L'artefatto caricato da GitHub Actions e' uno zip con il contenuto della cartella
  dist\APPhash. Viene firmato solo APPhash.exe; i file di terze parti in _internal
  non vengono firmati con il certificato del progetto.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="APPhash.exe" product-name="APPhash">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
